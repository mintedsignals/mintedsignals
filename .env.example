# Absolute site origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ad zone IDs (phase 6). Leave empty: slots render nothing in production
# and a labelled placeholder in development.
NEXT_PUBLIC_AD_ZONE_728X90=
NEXT_PUBLIC_AD_ZONE_300X250=
NEXT_PUBLIC_AD_ZONE_300X600=
NEXT_PUBLIC_AD_ZONE_NATIVE=

# Optional API base URL overrides (testing, or Kalshi's demo environment). Leave unset in production.
# POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
